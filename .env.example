# =============================================================================
# RedesComerciales_Web — variables de entorno
# Copia este archivo a .env.local para desarrollo (no commitear .env.local)
# En Hostinger, configura las mismas variables en el panel de despliegue.
# =============================================================================

# --- API / backend ---
GEMINI_API_KEY=

# Supabase (portal interno — opcional si usas auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Ecosistema: enlaces a otras aplicaciones ---
# Desarrollo local (valores por defecto si se dejan vacíos):
#   VITE_SALES_URL      → http://localhost:3001  (RedesComerciales_Sales)
#   VITE_PLATAFORMA_URL → http://localhost:5174  (RedesComerciales_Plataforma)
# Producción: sustituir por las URLs reales cuando estén disponibles.
VITE_SALES_URL=http://localhost:3001
VITE_PLATAFORMA_URL=http://localhost:5174

# Alias alternativo aceptado para la plataforma:
# VITE_PLATFORM_URL=http://localhost:5174

# --- SEO (producción) ---
# Dominio canónico en Hostinger:
VITE_SITE_URL=https://redescomerciales.pro
VITE_OG_IMAGE_URL=

# --- Analytics (opcional) ---
VITE_GTM_ID=
VITE_GA4_ID=
