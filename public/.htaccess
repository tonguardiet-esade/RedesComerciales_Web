<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical: HTTPS + apex en un solo salto 301 (conserva path y query string)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://redescomerciales.pro%{REQUEST_URI} [L,R=301,NE,QSA]

  # Rutas marketing: servir HTML estático prerenderizado si existe
  RewriteRule ^(soluciones|metodologia|casos-de-exito|contacto|aviso-legal|politica-cookies|politica-privacidad)/?$ $1/index.html [L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # HSTS: requiere mod_headers activo en Apache (Hostinger suele soportarlo)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
